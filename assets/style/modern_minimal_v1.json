      "color": "#f5f5f5",
      "roughness": 0.82,
      "metalness": 0.02,
      "texture": {
        "albedo": "textures/wall/plaster_diff.jpg",
        "normal": "textures/wall/plaster_normal.jpg",
        "roughness": "textures/wall/plaster_rough.jpg"
      }
    },

    "wall_feature_microcement": {
      "type": "microcement",
      "color": "#d9d6d2",
      "roughness": 0.75,
      "metalness": 0.05,
      "texture": {
        "albedo": "textures/wall/microcement_diff.jpg",
        "normal": "textures/wall/microcement_normal.jpg",
        "roughness": "textures/wall/microcement_rough.jpg"
      }
    },

    "wall_tile_light": {
      "type": "tile",
      "color": "#eaeaea",
      "roughness": 0.35,
      "metalness": 0.0,
      "texture": {
        "albedo": "textures/tile/tile_light_diff.jpg",
