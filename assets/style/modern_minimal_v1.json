  "mapping": {
    "rooms": {
      "living": {
        "floor": "floor_wood_oak",
        "wall": "wall_main",
        "featureWall": "wall_feature_microcement"
      },
      "bedroom": {
        "floor": "floor_wood_oak",
        "wall": "wall_main"
      },
      "kitchen": {
        "floor": "floor_tile_gray",
        "wall": "wall_tile_light"
      },
      "bathroom": {
        "floor": "floor_tile_dark",
        "wall": "wall_tile_light"
      }
    },

    "doors": {
      "entrance": "door_entrance",
      "default": "door_interior_white"
    },

    "windows": {
      "default": "glass_clear",
      "kitchen": "glass_tinted",
      "bathroom": "glass_frosted"
    }
  },

  "furniturePreset": {
    "style": "modern_minimal",
    "recommended": {
      "sofa": ["sofa_modern_light_01", "sofa_modern_gray_02"],
      "bed": ["bed_minimal_wood_01"],
      "table": ["table_minimal_01"],
      "chair": ["chair_light_01"]
    }
  }
}
