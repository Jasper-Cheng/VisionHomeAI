      "roughness": 0.05,
      "metalness": 0.0,
      "transmission": 0.95,
      "ior": 1.45
    },

    "glass_frosted": {
      "type": "glass",
      "color": "#e8eef2",
      "opacity": 0.6,
      "roughness": 0.85,
      "metalness": 0.0,
      "transmission": 0.4,
      "ior": 1.45
    },

    "glass_tinted": {
      "type": "glass",
      "color": "#d8cbb5",
      "opacity": 0.4,
      "roughness": 0.2,
      "metalness": 0.0,
      "transmission": 0.7,
      "ior": 1.45
    }
